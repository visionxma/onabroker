# On Broker — configuração Apache (GoDaddy / cPanel / Hostinger)
# Suba este arquivo junto com o site. Em cPanel, ative "mostrar arquivos
# ocultos" no Gerenciador de Arquivos para vê-lo depois de enviado.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Canonicaliza para a versão SEM www.
  #    Sem esta regra, www.onabroker.io e onabroker.io respondem as duas —
  #    o Google trata como dois sites com conteúdo idêntico e divide o valor
  #    entre eles. É o erro de configuração mais comum e mais silencioso.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # 3) Remove index.html da URL, para não existirem duas rotas para a mesma
  #    página (/sobre/ e /sobre/index.html).
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

ErrorDocument 404 /404.html
